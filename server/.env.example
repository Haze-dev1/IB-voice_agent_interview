# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
# Optional: leave empty to create a new room
# DAILY_ROOM_URL=

# Cartesia (TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Deepgram (STT)
DEEPGRAM_API_KEY=

# Groq (LLM)
GROQ_API_KEY=
# Optional: defaults to llama-3.3-70b-versatile
# GROQ_MODEL=

# TypeSafe (Answer Judgment)
# TYPESAFE_API_KEY is set as a global environment variable on this machine
# Do not duplicate it here - it's read directly from the environment
